    -- ตัวเลือกเปลี่ยนภาษา
    local LangLabel = Instance.new("TextLabel")
    LangLabel.Size = UDim2.new(0.15, 0, 0.04, 0)
    LangLabel.Position = UDim2.new(0.15, 0, 0.16, 0)
    LangLabel.Text = "เปลี่ยนภาษา AI:"
    LangLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    LangLabel.BackgroundTransparency = 1
    LangLabel.Parent = AIFrame

    local langs = {{"ไทย", "TH"}, {"Eng", "EN"}, {"Français", "FR"}}
    for i, l in ipairs(langs) do
        local LBtn = Instance.new("TextButton")
        LBtn.Size = UDim2.new(0.08, 0, 0.04, 0)
        LBtn.Position = UDim2.new(0.28 + ((i - 1) * 0.09), 0, 0.16, 0)
        LBtn.Text = l[1]
        LBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
        LBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        LBtn.Parent = AIFrame

        LBtn.MouseButton1Click:Connect(function()
            CurrentLang = l[2]
            ChatText.Text = ChatText.Text .. "\n[ระบบ]: เปลี่ยนภาษาเป็น " .. l[1] .. " เรียบร้อย\n"
        end)
    end

    -- ฟังก์ชันส่งคำถามไปยัง AI API และแสดงผลตรงๆ
    local function SendQuestion()
        local question = InputBox.Text
        if question == "" then return end
        
        InputBox.Text = ""
        ChatText.Text = ChatText.Text .. "\n[คุณ]: " .. question
        ChatText.Text = ChatText.Text .. "\n[AIกำลังประมวลผล...]"

        task.spawn(function()
            local promptPrefix = LanguagePrompts[CurrentLang] or LanguagePrompts["TH"]
            local fullPrompt = promptPrefix .. " " .. question
            
            local success, response = pcall(function()
                local requestUrl = "https://api.simsimi.vn/v1/simtalk"
                local responseData = request({
                    Url = requestUrl,
                    Method = "POST",
                    Headers = { ["Content-Type"] = "application/x-www-form-urlencoded" },
                    Body = "text=" .. HttpService:UrlEncode(fullPrompt) .. "&lc=" .. string.lower(CurrentLang)
                })
                return HttpService:JSONDecode(responseData.Body)
            end)

            -- ทำการลบข้อความกำลังประมวลผล
            ChatText.Text = string.gsub(ChatText.Text, "\n%[AIกำลังประมวลผล...%]", "")

            if success and response and response.message then
                ChatText.Text = ChatText.Text .. "\n[AI]: " .. response.message .. "\n"
            else
                -- Fallback หาก API ไม่ตอบสนอง
                ChatText.Text = ChatText.Text .. "\n[AI]: รับทราบคำถามเรื่อง '" .. question .. "' ระบบกำลังประมวลผลข้อมูลในฐานข้อมูลให้โดยตรง\n"
            end
        end)
    end

    SendBtn.MouseButton1Click:Connect(SendQuestion)
    InputBox.FocusLost:Connect(function(enterPressed)
        if enterPressed then SendQuestion() end
    end)
end

-- ปุ่มเปิดระบบแชท AI ใน CascadeUI
AISection:CreateButton({
    Name = "เปิดระบบแชท AI",
    Callback = function()
        CreateAIGUI()
    end
})
